# Site
# URL publica canonica do site.
# Local: http://localhost:3000
# Producao atual (Vercel, sem dominio proprio ainda): https://poncell-portifolio.vercel.app
# Se um dominio proprio for configurado no futuro, troque para ele aqui e no
# painel da Vercel (ver docs/domain-search-console-checklist.md).
# Usada em metadata, Open Graph, sitemap e robots.
NEXT_PUBLIC_SITE_URL=

# Google Search Console (opcional)
# Cole aqui o token de verificacao "meta tag" gerado pelo Search Console ao
# criar uma propriedade do tipo "Prefixo de URL" para a URL de producao.
# Sem dominio proprio, o tipo "Dominio" nao pode ser usado (exige registro
# TXT na zona DNS de vercel.app, que nao pertence ao projeto).
# Deixe vazio se ainda nao configurou o Search Console.
GOOGLE_SITE_VERIFICATION=

# Supabase - publico
# Pode ser usado no client. Valor encontrado no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase - legado/opcional
# Use apenas se o projeto ainda estiver com anon key legada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - servidor
# Use somente no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
# E-mail autorizado a acessar /admin. Preencha apenas em .env.local.
ADMIN_EMAIL=

# GitHub
# GITHUB_USERNAME e publico; GITHUB_TOKEN e opcional e somente servidor.
GITHUB_USERNAME=
GITHUB_TOKEN=
